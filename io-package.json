{
	"common": {
		"name": "dreo-cloud",
		"version": "0.1.2-beta.1",
		"news": {
			"0.1.2-beta.1": {
				"en": "Added support for older DREO devices without a poweron state",
				"de": "Unterstützung für ältere DREO-Geräte ohne poweron-Datenpunkt hinzugefügt"
			},
			"0.1.1": {
				"en": "Added the official adapter logo and moved full device serial numbers to debug logs only",
				"de": "Offizielles Adapterlogo hinzugefügt und vollständige Geräteseriennummern nur noch im Debug-Log ausgegeben"
			},
			"0.1.0": {
				"en": "Initial public release",
				"de": "Erste öffentliche Veröffentlichung"
			}
		},
		"titleLang": {
			"en": "DREO Cloud",
			"de": "DREO Cloud"
		},
		"desc": {
			"en": "Control and monitor DREO cloud-connected smart home devices.",
			"de": "Steuern und überwachen Sie mit der Cloud verbundene Smart-Home-Geräte von DREO."
		},
		"authors": ["mehrwiedu <david@vonderhoeh.net>"],
		"keywords": ["dreo", "fan", "ceiling fan", "humidifier", "air purifier", "smart home", "cloud"],
		"licenseInformation": {
			"type": "free",
			"license": "MIT"
		},
		"platform": "Javascript/Node.js",
		"icon": "dreo-cloud.png",
		"enabled": true,
		"extIcon": "https://raw.githubusercontent.com/mehrwiedu/ioBroker.dreo-cloud/main/admin/dreo-cloud.png",
		"readme": "https://github.com/mehrwiedu/ioBroker.dreo-cloud/blob/main/README.md",
		"loglevel": "info",
		"tier": 3,
		"mode": "daemon",
		"type": "climate-control",
		"compact": true,
		"connectionType": "cloud",
		"dataSource": "push",
		"adminUI": {
			"config": "json"
		},
		"dependencies": [
			{
				"js-controller": ">=6.0.11"
			}
		],
		"globalDependencies": [
			{
				"admin": ">=7.0.23"
			}
		]
	},
	"native": {
		"email": "",
		"password": "",
		"region": "EU"
	},
	"objects": [],
	"instanceObjects": [
		{
			"_id": "info",
			"type": "channel",
			"common": {
				"name": "Information"
			},
			"native": {}
		},
		{
			"_id": "info.connection",
			"type": "state",
			"common": {
				"role": "indicator.connected",
				"name": "Device or service connected",
				"type": "boolean",
				"read": true,
				"write": false,
				"def": false
			},
			"native": {}
		}
	],
	"encryptedNative": ["password"],
	"protectedNative": ["password"]
}
